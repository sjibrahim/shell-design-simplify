# ---- Server ----
PORT=4000
NODE_ENV=production

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=shell_admin

# ---- JWT ----
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# ---- Default Admin (created on first migrate) ----
DEFAULT_ADMIN_EMAIL=admin@shell.com
DEFAULT_ADMIN_PASSWORD=admin123

# ---- CORS ----
# Comma-separated, or * to allow all
CORS_ORIGINS=*
